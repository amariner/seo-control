{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "viewer",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@seo/viewer",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "workbench",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@seo/workbench",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "viewer-qa",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@seo/viewer",
        "exec",
        "next",
        "dev",
        "--port",
        "3020"
      ],
      "port": 3020
    },
    {
      "name": "workbench-qa",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@seo/workbench",
        "exec",
        "next",
        "dev",
        "--hostname",
        "127.0.0.1",
        "--port",
        "3021"
      ],
      "port": 3021
    },
    {
      "name": "viewer-auth-qa",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DEV_AUTH_BYPASS=false",
        "AUTH_GOOGLE_ID=qa-client",
        "AUTH_GOOGLE_SECRET=qa-secret",
        "ALLOWED_GOOGLE_EMAILS=marinerandreu@gmail.com",
        "pnpm",
        "--filter",
        "@seo/viewer",
        "exec",
        "next",
        "dev",
        "--port",
        "3022"
      ],
      "port": 3022
    }
  ]
}
