{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "viewer",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@seo/viewer",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "workbench",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@seo/workbench",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "viewer-qa",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@seo/viewer",
        "exec",
        "next",
        "dev",
        "--port",
        "3020"
      ],
      "port": 3020
    },
    {
      "name": "workbench-qa",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@seo/workbench",
        "exec",
        "next",
        "dev",
        "--hostname",
        "127.0.0.1",
        "--port",
        "3021"
      ],
      "port": 3021
    }
  ]
}
