# Viewer / workbench
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/TENANT_ID/v2.0
ALLOWED_ENTRA_OBJECT_IDS=
AUTH_TRUST_HOST=true

# DEV_AUTH_BYPASS must never be enabled on Vercel or production.
DEV_AUTH_BYPASS=true

# Neon PostgreSQL (Frankfurt in phase 2)
DATABASE_URL=

# Service-only mutations
SERVICE_TOKEN=
CRON_SECRET=
PUBLISHING_PUBLIC_KEY=

# Optional cloud connectors. Secrets should come from Azure Key Vault in production.
GA4_SERVICE_ACCOUNT_JSON=
GSC_SERVICE_ACCOUNT_JSON=
SEMRUSH_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
