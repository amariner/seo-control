# Viewer / workbench
AUTH_SECRET=replace-with-at-least-32-random-characters
# Acceso con Google (D-047): cliente OAuth web propio, distinto del de GSC.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Emails autorizados, separados por comas. Vacío = nadie entra.
ALLOWED_GOOGLE_EMAILS=
# Entra ID, preparado para cuando se registre la aplicación (se activa con el client ID).
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/TENANT_ID/v2.0
ALLOWED_ENTRA_OBJECT_IDS=
AUTH_TRUST_HOST=true

# DEV_AUTH_BYPASS must never be enabled on Vercel or production.
DEV_AUTH_BYPASS=true

# Neon PostgreSQL (Frankfurt in phase 2)
DATABASE_URL=

# Service-only mutations
SERVICE_TOKEN=
CRON_SECRET=
PUBLISHING_PUBLIC_KEY=

# Optional cloud connectors. Secrets should come from Azure Key Vault in production.
# Origen de datos del visor: synthetic (por defecto) | live | database (D-028, D-034).
# SEO_DATA_SOURCE=live
# Acceso público temporal del visor, sin login (D-035). Nunca en un entorno con datos sensibles sin decisión explícita.
# PUBLIC_ACCESS=true
# Origen live: cuenta de servicio GA4 (JSON o base64) y OAuth de solo lectura para Search Console (mismas credenciales que V1).
GA4_SERVICE_ACCOUNT_JSON=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GA4_PROPERTY_ID_PORCELANOSA=
GA4_PROPERTY_ID_NOKEN=
GSC_SITE_URL_PORCELANOSA=
GSC_SITE_URL_NOKEN=
GSC_SERVICE_ACCOUNT_JSON=
SEMRUSH_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
